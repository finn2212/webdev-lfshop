{%- comment -%}
  seo-jsonld.liquid — Globales JSON-LD Schema.org Markup.

  Ausgabe pro Seitentyp:
    - immer:        Organization (Brand-Logo, sameAs Social-Profile)
    - homepage:     + WebSite mit SearchAction (Google Sitelinks Search Box)
    - product PDP:  + Product mit Offer/AggregateRating wenn verfügbar
    - article:      + BlogPosting mit author/datePublished/headline
    - collection:   + ItemList der gezeigten Produkte
    - immer:        + BreadcrumbList (sofern wir Tiefe ableiten können)

  Eingehängt einmal in layout/theme.liquid im <head>.

  Brand-Settings unten zentral pflegen — Social-Profile-URLs sind
  zentralisiert, damit Updates nur an einer Stelle nötig sind.
{%- endcomment -%}

{%- liquid
  assign brand_name        = shop.name
  assign brand_logo_url    = settings.logo | default: settings.favicon | image_url: width: 600
  assign brand_description = "Karten, Reise-Guides und Lightroom-Presets von Laura & Finn — eine deutsche Familie, die selbst durch Bali, Südafrika, Thailand und Australien gereist ist."
  assign instagram_url     = "https://www.instagram.com/laurandfinn/"
  assign youtube_url       = "https://www.youtube.com/@laurandfinn"
  assign tiktok_url        = "https://www.tiktok.com/@laurandfinn"
  assign pinterest_url     = "https://www.pinterest.com/laurandfinn/"
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{ shop.url }}/#organization",
  "name": {{ brand_name | json }},
  "url": {{ shop.url | json }},
  {%- if brand_logo_url != blank -%}
  "logo": {
    "@type": "ImageObject",
    "url": "https:{{ brand_logo_url }}"
  },
  {%- endif -%}
  "description": {{ brand_description | json }},
  "sameAs": [
    {{ instagram_url | json }},
    {{ youtube_url | json }},
    {{ tiktok_url | json }},
    {{ pinterest_url | json }}
  ]
}
</script>

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop.url }}/#website",
  "name": {{ brand_name | json }},
  "url": {{ shop.url | json }},
  "publisher": { "@id": "{{ shop.url }}/#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  },
  "inLanguage": {{ request.locale.iso_code | json }}
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 5000 | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- if product.featured_image != blank -%}
  "image": "https:{{ product.featured_image | image_url: width: 1600 }}",
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ brand_name | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}",
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": { "@id": "{{ shop.url }}/#organization" }
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": "{{ shop.url }}{{ article.url }}#article",
  "headline": {{ article.title | json }},
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified":  "{{ article.updated_at  | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": { "@id": "{{ shop.url }}/#organization" },
  {%- if article.image != blank -%}
  "image": "https:{{ article.image | image_url: width: 1600 }}",
  {%- endif -%}
  "mainEntityOfPage": "{{ shop.url }}{{ article.url }}",
  "articleBody": {{ article.content | strip_html | truncate: 5000 | json }}
}
</script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection and collection.products.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "{{ shop.url }}{{ collection.url }}#collection",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | truncate: 600 | json }},
  "url": "{{ shop.url }}{{ collection.url }}",
  "isPartOf": { "@id": "{{ shop.url }}/#website" },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count | default: collection.products.size }},
    "itemListElement": [
      {%- for product in collection.products limit: 12 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": "{{ shop.url }}{{ product.url }}",
          "name": {{ product.title | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endif -%}
