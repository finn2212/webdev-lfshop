<!-- /sections/section-collection-row.liquid -->
{%- liquid
  assign collection_products = collections[section.settings.collection].products
  assign product_list = section.settings.product_list
  assign products = product_list | default: collection_products
  assign desktop_grid = ''
  assign mobile_grid = section.settings.grid_small | default: 2

  if section.settings.grid_large == 2
    assign desktop_grid = 'large-up--one-half'
  elsif section.settings.grid_large == 3
    assign desktop_grid = 'large-up--one-third'
  elsif section.settings.grid_large == 4
    assign desktop_grid = 'large-up--one-quarter'
  endif

  assign scroll_id = 'collection-row-' | append: section.id
-%}

<div
  class="collection-row {{ section.settings.bg }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-row"
  style="--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ section.settings.width }} section-padding">
    {%- if section.settings.heading != blank -%}
      <div class="collection-row__heading {{ section.settings.align_text }}">
        <h2 class="h3">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div
      class="collection-split__products grid"
      id="{{ scroll_id }}"
      style="--product-width: calc({{ 100 | divided_by: mobile_grid | append: 'vw' }} - var(--gutter)*2);"
    >
      {%- if products != blank -%}
        {%- for _product in products limit: section.settings.limit -%}
          <div class="collection-split__product grid__item {{ desktop_grid }}">
            {% render 'product-grid-item', product: _product, text_align: 'text-left' %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign wrap_class = 'collection-split__product grid__item ' | append: desktop_grid -%}
        {%- render 'onboarding-product-grid-item', limit: section.settings.limit, wrap: wrap_class -%}
      {%- endif -%}
    </div>

    {% render 'scrollbar', container_id: scroll_id %}
  </div>
</div>

<style>
  [data-section-id="{{ section.id }}"] .collection-row__heading {
    margin-bottom: 16px;
  }

  [data-section-id="{{ section.id }}"] .collection-split__products {
    scrollbar-width: none;
  }

  [data-section-id="{{ section.id }}"] .collection-split__products::-webkit-scrollbar {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Collection row",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Product list",
      "info": "Overrides collection if set"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_large",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_small",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Products per row (mobile)",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "limit",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Product limit",
      "default": 4
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Heading alignment",
      "default": "text-left",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Center"},
        {"value": "text-right", "label": "Right"}
      ]
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background color",
      "default": "palette--light bg--neutral",
      "options": [
        {"value": "palette--light bg--neutral", "label": "Default"},
        {"value": "palette--light bg--accent", "label": "Light"},
        {"value": "palette--dark bg--invert", "label": "Dark"},
        {"value": "palette--dark bg--invert--accent", "label": "Dark accent"}
      ]
    },
    {
      "type": "header",
      "content": "Scrollbar colors"
    },
    {
      "type": "color",
      "id": "scrollbar_btn_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "scrollbar_track_color",
      "label": "Track color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "scrollbar_progress_color",
      "label": "Progress color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "default": "wrapper--full",
      "options": [
        {"value": "wrapper--full", "label": "Full width padded"},
        {"value": "wrapper", "label": "Page width"}
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Collection row",
      "category": "Collection"
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside"]
  }
}
{% endschema %}
