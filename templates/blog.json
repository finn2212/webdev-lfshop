        "blog-custom-article": { "type": "article", "settings": { "article": "", "show_tag": true, "show_date": false, "text_size": 5, "show_excerpt": true, "align_text": "text-left", "placement_text": "middle", "show_author_name": true, "show_author_image": true, "button_text": "Weiterlesen", "button_size": "", "button_style": "text-link", "button_color": "btn--neutral", "text_color": "text--neutral", "bg_color": "#f7f7f7" } }
